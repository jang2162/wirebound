{
  "name": "@wirebound/exporter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": "./src/browser/index.ts",
    "./runtime.js": "./dist/runtime.js",
    "./test-support": "./test-support/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && vite build -c vite.runtime.config.ts",
    "build:runtime": "vite build -c vite.runtime.config.ts",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "@wirebound/renderer": "workspace:*",
    "@wirebound/schema": "workspace:*",
    "@wirebound/theme-sdk": "workspace:*",
    "@wirebound/themes": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fflate": "^0.8.3",
    "@wirebound/test-support": "workspace:*",
    "tsdown": "^0.22.14",
    "vite": "^6.0.0"
  }
}
