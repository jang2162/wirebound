{
  "name": "@wirebound/theme-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "wb-theme": "./dist/bin.js" },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown && vite build -c vite.client.config.ts",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "vite": "^6.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@wirebound/theme-sdk": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wirebound/renderer": "workspace:*",
    "@wirebound/schema": "workspace:*",
    "@wirebound/theme-gallery": "workspace:*",
    "@wirebound/theme-sdk": "workspace:*",
    "@wirebound/themes": "workspace:*",
    "playwright-core": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14"
  }
}
