{
  "name": "@wirebound/theme-kit",
  "version": "0.1.1",
  "description": "wirebound 테마 작성 도구 wb-theme — dev 갤러리 · build(.wbtheme) · check · shots",
  "keywords": [
    "wirebound",
    "theme",
    "cli",
    "wb-theme"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jang2162/wirebound/tree/main/packages/theme-kit#readme",
  "bugs": {
    "url": "https://github.com/jang2162/wirebound/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jang2162/wirebound.git",
    "directory": "packages/theme-kit"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wb-theme": "./bin/wb-theme.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown && vite build -c vite.client.config.ts",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.0",
    "playwright-core": "^1.62.1",
    "vite": "^6.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@wirebound/theme-sdk": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wirebound/renderer": "workspace:*",
    "@wirebound/schema": "workspace:*",
    "@wirebound/theme-gallery": "workspace:*",
    "@wirebound/theme-sdk": "workspace:*",
    "@wirebound/themes": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
