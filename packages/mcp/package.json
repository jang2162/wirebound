{
  "name": "@wirebound/mcp",
  "version": "0.1.1",
  "description": "wirebound 설계서를 에이전트에게 여는 MCP 서버 wireb-mcp (stdio)",
  "keywords": [
    "wirebound",
    "mcp",
    "model-context-protocol",
    "wireframe"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jang2162/wirebound/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/jang2162/wirebound/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jang2162/wirebound.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wireb-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wirebound/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@wirebound/test-support": "workspace:*",
    "tsdown": "^0.22.14"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
