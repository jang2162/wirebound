{
  "name": "@wirebound/theme-sdk",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "development": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./version": {
      "development": "./src/version.ts",
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./capture": {
      "development": "./src/capture.ts",
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "default": "./dist/capture.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js",
        "default": "./dist/runtime.js"
      },
      "./version": {
        "types": "./dist/version.d.ts",
        "import": "./dist/version.js",
        "default": "./dist/version.js"
      },
      "./capture": {
        "types": "./dist/capture.d.ts",
        "import": "./dist/capture.js",
        "default": "./dist/capture.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14"
  }
}
