{
  "name": "@wirebound/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wireb": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./embed": {
      "development": "./src/embed.ts",
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./test-support": "./test-support/index.ts"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "@wirebound/schema": "workspace:*",
    "@wirebound/themes": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsdown": "^0.22.14"
  }
}
