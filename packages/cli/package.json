{
  "name": "@wirebound/cli",
  "version": "0.1.0",
  "description": "wirebound 설계서를 구현 리포에서 읽고 내보내는 CLI wireb — pull · export · lint · page get",
  "keywords": [
    "wirebound",
    "wireframe",
    "cli",
    "wireb"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jang2162/wirebound/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/jang2162/wirebound/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jang2162/wirebound.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wireb": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./embed": {
      "development": "./src/embed.ts",
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./test-support": "./test-support/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "@wirebound/schema": "workspace:*",
    "@wirebound/themes": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@wirebound/test-support": "workspace:*",
    "tsdown": "^0.22.14"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./embed": {
        "types": "./dist/embed.d.ts",
        "import": "./dist/embed.js",
        "default": "./dist/embed.js"
      }
    }
  }
}
