# **운영 compose 의 값** — 저장소 뿌리에서 `cp deploy/.env.example deploy/.env` 로 만들어 채운다(`.env` 는 gitignore 된다). compose 가 이 디렉터리의
# `.env` 를 스스로 읽고, api · migrate 컨테이너에도 그대로 싣는다(`docker-compose.yml` 의 `env_file`).
# **이미지에는 비밀이 없다** — 값은 전부 여기서 기동 때 온다.
#
# api 가 읽는 값의 목록과 뜻은 `apps/api/.env.example` 이 갖는다 — 여기에는 운영에서 적어야 하는 것만 든다.
# 이 파일에 **적지 않는** 것: `POSTGRES_PORT`(개발용 compose 의 값 — 있으면 api 가 접속 문자열과 견준다) · `HOST` · `PORT` ·
# `NODE_ENV`(이미지가 정한다) · `DATABASE_URL` · `TRUST_PROXY`(compose 가 아래 값으로 짓는다).
# **compose 의 `${…}` 를 더하거나 빼면 같은 커밋에서 이 파일도 고친다** — 배포할 때 넣을 키의 목록이 이 파일이다.

# 앞단이 받을 주소. 도메인이면 Caddy 가 인증서를 받는다 — 그 도메인이 이 서버를 가리키고 80 · 443 이 바깥에서 닿아야 한다.
SITE_ADDRESS=wirebound.example.com

# Postgres 비밀번호. **영숫자로 적는다** — compose 가 이 값을 접속 문자열(`postgres://…:<값>@…`)에 그대로 끼운다.
# **처음 `up` 한 뒤에 바꿔도 DB 는 안 바뀐다** — Postgres 는 빈 볼륨에서만 이 값을 읽는다.
POSTGRES_PASSWORD=

# **최초 계정 — `migrate` 가 만든다.** 이미 있는 이메일이면 그대로 둔다. 계정을 만든 뒤에는 비밀번호 줄을 비워도 된다
# (api 컨테이너는 이 셋을 빈 값으로 받는다 — `docker-compose.yml`).
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=

# 세션 쿠키 이름 · 만료(시간).
SESSION_COOKIE_NAME=wb_session
SESSION_TTL_HOURS=720

LOG_LEVEL=info

# 동시에 뜨는 화면 그리기 브라우저 수(pptx) — README 「배포하려면」의 「화면 그리기 상한」.
#EXPORT_RENDER_LIMIT=2

# 바깥 포트. 앞단만 연다.
#HTTP_PORT=80
#HTTPS_PORT=443

# compose 네트워크 대역 · 다른 컨테이너가 받는 범위 · 앞단의 고정 주소 — api 가 믿는 앞단이 이 주소다. 서버의 다른 네트워크와
# 겹칠 때만 바꾼다(셋을 함께 — 앞단의 주소는 대역 안 · 범위 밖).
#BACKEND_SUBNET=10.231.47.0/24
#BACKEND_IP_RANGE=10.231.47.128/25
#EDGE_IP=10.231.47.2

# 지은 이미지에 붙는 태그 — `wirebound-api:<값>` · `wirebound-web:<값>`. 비우면 `local`.
#WIREBOUND_TAG=local
