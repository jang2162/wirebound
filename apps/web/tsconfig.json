{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "composite": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // packages/schema는 브라우저·Node 양쪽에서 돌아야 해서 DOM 전역을 일부러
    // 배제한다. 여기는 브라우저 전용 앱이므로 DOM이 있어야 한다.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  // `vite.config.ts`는 여기 없다 — `tsconfig.node.json`이 든다. 그 파일만 Node 타입을
  // 요구하고, 이 프로그램은 브라우저 전용으로 남아야 한다.
  "include": ["src", "test", "config"],
  "references": [{ "path": "../../packages/schema" }, { "path": "../../packages/renderer" }]
}
