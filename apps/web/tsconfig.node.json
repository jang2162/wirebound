{
  // **빌드 시각에 도는 것만 여기 산다.** `vite.config.ts`는 `node:fs`·`node:util`로
  // `apps/api/.env`를 읽으므로 Node 타입이 필요한데, 그것을 `tsconfig.json`에 넣으면
  // 브라우저 코드(`src`)까지 `process`·`Buffer`를 보게 된다. 그래서 갈라 둔다 —
  // `apps/web/config/*`가 순수한 것도 같은 이유다(그쪽은 브라우저 프로그램에 산다).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"],
  "references": [{ "path": "./tsconfig.json" }]
}
