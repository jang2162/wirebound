# PostgreSQL 접속 문자열. 필수 — 값이 없으면 서버가 뜨지 않는다.
DATABASE_URL=postgres://wirebound:wirebound@127.0.0.1:5433/wirebound

# 서버가 열 포트와 바인딩 호스트.
PORT=3001
HOST=127.0.0.1

# development | test | production
NODE_ENV=development

# 세션 쿠키 이름과 만료 시간(시간 단위).
SESSION_COOKIE_NAME=wb_session
SESSION_TTL_HOURS=720

# scrypt 비밀번호 해시의 N 파라미터(CPU/메모리 비용).
PASSWORD_SCRYPT_N=32768

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PPTX 화면 이미지를 그릴 브라우저 실행 파일. **비워 두면 playwright-core 가 자기 캐시에서
# 찾는다** — 그것이 기본 길이고, 캐시에 넣는 명령은 최상위 README 의 "PPTX" 절에 있다.
# 기계에 이미 있는 브라우저(배포판 chromium 등)를 쓰려면 그 경로를 여기 적는다.
# playwright-core 는 이 값을 받는 환경변수를 스스로 내지 않는다 — 이 줄이 그 길이다.
#SCREEN_CHROMIUM_PATH=/usr/bin/chromium
