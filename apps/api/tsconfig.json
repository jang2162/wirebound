{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "composite": true,
    "types": ["node"]
  },
  "include": ["src", "test"],
  "references": [
    { "path": "../../packages/schema" },
    { "path": "../../packages/themes" },
    // **`exporter`를 참조로 잡는다**(P8-4 T2). 참조가 없으면 tsc가 그 패키지의 소스를
    // 이 프로그램의 옵션(`lib: ES2022` · jsx 없음 · `types: ["node"]`)으로 컴파일해
    // 그쪽의 브라우저 파일과 `.tsx`에서 깨진다 — 참조로 잡으면 빌드된 선언만 본다.
    { "path": "../../packages/exporter" }
  ]
}
