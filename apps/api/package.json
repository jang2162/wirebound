{
  "name": "@wirebound/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts latest",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@wirebound/exporter": "workspace:*",
    "@wirebound/schema": "workspace:*",
    "@wirebound/themes": "workspace:*",
    "fastify": "^5.2.0",
    "kysely": "^0.28.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
