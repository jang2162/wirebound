{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/*.md",
    "**/*.css",
    "**/*.html",
    "pnpm-lock.yaml",
    "guideline-lock.json",
    "guideline.json",
    "docs/guideline/**",
    ".ruler/**"
  ]
}
