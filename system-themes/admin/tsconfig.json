{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    // 빌드 산출물이 없다 — 이 차수의 소비자는 소스를 읽는 vite · vitest 뿐이다(`.wbtheme` 빌드는 A2).
    "noEmit": true,
    "composite": true,
    "outDir": ".tsbuild",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test"],
  "references": [{ "path": "../../packages/theme-sdk" }]
}
