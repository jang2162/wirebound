# **배포 compose(`compose.yaml`)의 값** — 저장소 뿌리에서 `cp .env.example .env` 로 만들어 채운다(`.env` 는 gitignore 된다).
# compose 가 뿌리의 `.env` 를 스스로 읽고, api · migrate 컨테이너에도 그대로 싣는다(`compose.yaml` 의 `env_file`).
# Komodo 는 Stack Environment 를 이 자리(`.env`)에 써서 준다. **이미지에는 비밀이 없다** — 값은 전부 여기서 기동 때 온다.
#
# **개발 명령은 이 파일을 안 읽는다** — 개발 DB(`pnpm db …`) · api 스크립트는 `apps/api/.env` 를 읽는다.
#
# api 가 읽는 값의 목록과 뜻은 `apps/api/.env.example` 이 갖는다 — 여기에는 배포에서 적어야 하는 것만 든다.
# 이 파일에 **적지 않는** 것: `POSTGRES_PORT`(개발 compose 의 값 — 있으면 api 가 접속 문자열과 견준다) · `HOST` · `PORT` ·
# `NODE_ENV`(이미지가 정한다) · `DATABASE_URL` · `TRUST_PROXY`(compose 가 아래 값으로 짓는다).
# **compose 의 `${…}` 를 더하거나 빼면 같은 커밋에서 이 파일과 `docs/guides/deploy-docker.md` 의 환경 변수 표를 고친다.**

# 이 자리가 배포 자리라는 표지(필수 · `1`). 없으면 `up` · `down` 을 비롯한 모든 `docker compose` 가 멈춘다 — 운영 볼륨을 지우는
# `down -v` 가 배포 값이 없는 체크아웃에서 돌지 않게 한다.
WIREBOUND_DEPLOY=1

# Postgres 비밀번호(필수 · 비밀). **영숫자로 적는다** — compose 가 이 값을 접속 문자열(`postgres://…:<값>@…`)에 그대로 끼운다.
# **처음 `up` 한 뒤에 바꿔도 DB 는 안 바뀐다** — Postgres 는 빈 볼륨에서만 이 값을 읽는다.
POSTGRES_PASSWORD=

# **최초 계정 — `migrate` 가 만든다.** 이미 있는 이메일이면 그대로 둔다. 계정을 만든 뒤에는 비밀번호 줄을 비워도 된다
# (api 컨테이너는 이 셋을 빈 값으로 받는다 — `compose.yaml`).
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=

# 세션 쿠키 이름 · 만료(시간).
SESSION_COOKIE_NAME=wb_session
SESSION_TTL_HOURS=720

LOG_LEVEL=info

# 동시에 뜨는 화면 그리기 브라우저 수(pptx) — README 「배포하려면」의 「화면 그리기 상한」.
#EXPORT_RENDER_LIMIT=2

# 입구(web)가 호스트에 여는 HTTP 포트. 비우면 8080.
#APP_PORT=8080

# 입구 앞에 선 프록시의 주소(공백으로 가른 IP · CIDR) — 그 프록시가 적은 X-Forwarded-For 를 믿는다. 비우면 아무도 안 믿는다
# (클라이언트 주소 = 입구가 본 소켓 주소). **클라이언트가 닿는 대역을 적지 않는다** — 적으면 그 대역의 누구나 제 주소를 지어 적는다.
#TRUSTED_PROXIES=

# compose 네트워크 대역 · 다른 컨테이너가 받는 범위 · 입구의 고정 주소 — api 가 믿는 앞단이 이 주소다. 서버의 다른 네트워크와
# 겹칠 때만 바꾼다(셋을 함께 — 입구의 주소는 대역 안 · 범위 밖).
#BACKEND_SUBNET=10.231.47.0/24
#BACKEND_IP_RANGE=10.231.47.128/25
#EDGE_IP=10.231.47.2

# 지은 이미지에 붙는 태그 — `wirebound-api:<값>` · `wirebound-web:<값>`. 비우면 `local`.
#WIREBOUND_TAG=local
